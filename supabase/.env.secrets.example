# Secrets das Edge Functions (Supabase Dashboard → Project Settings → Edge Functions → Secrets)
# OU via CLI: npx supabase secrets set --env-file supabase/.env.secrets
#
# NÃO commitar o arquivo preenchido.
# Projeto: egupwrwzcuqazlshhfoq (vortexmu-log-pvp)
#
# Se ranking + logs_pvp estiverem no MESMO banco, EXTERNAL_* pode apontar
# para o próprio projeto (ou a function pode ser ajustada depois para usar SUPABASE_URL).
EXTERNAL_SUPABASE_URL=
EXTERNAL_SUPABASE_ANON_KEY=

# Discord webhooks
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_PROD=
DISCORD_WEBHOOK_URL_THRONE=
DISCORD_WEBHOOK_URL_LEGENDS=

# Pause global de posts automáticos (true/false)
AUTO_POST_PAUSED=false

# URL do front na Vercel (sem barra no final)
FRONTEND_URL=

# Opcional — só para pvp-ai-insights (gateway Lovable)
# LOVABLE_API_KEY=
